# Optional: makes the contact form send mail straight from the page via EmailJS (https://www.emailjs.com).
# Copy this file to .env and fill the three values. Without them the form opens the visitor's email app instead.
# Template variables used: from_name, reply_to, subject, message
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
